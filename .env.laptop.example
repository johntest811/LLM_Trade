# MSI GF63 11UCX low-latency local-model profile
#
# Merge these non-secret values into the laptop's private .env. Do not copy a
# public/example file over MT5 credentials. In LM Studio, load the official
# Qwen3.5-4B GGUF Q4_K_M file. The project accepts LM Studio's catalog ID
# qwen/qwen3.5-4b and resolves a shorter local API identifier such as qwen3.5-4b.
# Keep thinking disabled, Auto Unload disabled, GPU offload at maximum, and
# LM Studio's server concurrency at one. The project supplies its own strict
# response schema; LM Studio's global Structured Output toggle may stay off.

LLM_PROVIDER=local
LOCAL_LLM_MODEL=qwen/qwen3.5-4b
LOCAL_LLM_REQUIRED_QUANTIZATION=Q4_K_M
LOCAL_LLM_URL=http://127.0.0.1:1234/v1/chat/completions
LOCAL_LLM_CONTEXT_SIZE=4096
LOCAL_LLM_MAX_TOKENS=220
LOCAL_LLM_TEMPERATURE=0.0
LOCAL_LLM_TOP_P=0.8
LOCAL_LLM_SEED=42
LOCAL_LLM_TIMEOUT=25.0
LOCAL_LLM_MAX_RETRIES=1
LOCAL_LLM_STRUCTURED_OUTPUT=true
LLM_MAX_CONCURRENCY=1
# Two ranked candidates keep inference inside the completed-candle freshness
# window on the laptop's 4 GB RTX 2050. The wider market selector still scans
# every configured symbol before these model calls.
LLM_ENTRY_CANDIDATES_PER_BAR=2
DETERMINISTIC_ENTRY_FAST_PATH_ENABLED=true
EXIT_MODEL_CONFIRMATION_ENABLED=false

# Engine/UI cadence. M5 decisions still occur only on completed candles;
# these values control quote/health responsiveness between candle closes.
DECISION_POLL_SECONDS=0.5
MARKET_SELECTION_REFRESH_SECONDS=60
ENGINE_HEARTBEAT_STALE_SECONDS=30
MAX_ENTRY_DECISION_AGE_SECONDS=45
MAX_ENTRY_BAR_AGE_SECONDS=120
ENTRY_MAX_EXECUTION_DRIFT_ATR=0.25
ENTRY_STRONG_ALIGNMENT_MAX_EXECUTION_DRIFT_ATR=0.40
ENTRY_STRONG_ALIGNMENT_MIN_CONFIDENCE=0.80
ENTRY_MAX_CANDLE_RANGE_ATR=1.50
ENTRY_STRONG_ALIGNMENT_CHASE_MIN_CONFIDENCE=0.85
ENTRY_STRONG_ALIGNMENT_CHASE_MAX_EXTENSION_ATR=2.00

# Same bounded breakout calibration as the desktop profile. It does not bypass
# spread, margin, price-freshness, opposing-zone, or portfolio protections.
BREAKOUT_EXHAUSTION_CONTINUATION_ENABLED=true
BREAKOUT_EXHAUSTION_MAX_EXTENSION_ATR=0.75

# Keep the same bounded confidence exception and deterministic protection
# profile as the desktop configuration.
CONFIDENCE_THRESHOLD=0.70
FAILED_THESIS_REVERSAL_ENABLED=true
FAILED_THESIS_REVERSAL_MIN_CONFIDENCE=0.60
SAME_THESIS_REENTRY_MIN_BARS=2
AUTO_CLOSE_TARGET_LOSS_ENABLED=true
AUTO_CLOSE_TARGET_LOSS_USD=2.00
MICRO_PROFIT_PROTECTION_ENABLED=false
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_TRIGGER_R=0.50
PROFIT_LOCK_TRIGGER_USD=0.35
PROFIT_LOCK_FLOOR_USD=0.08
PROFIT_LOCK_MID_TRIGGER_R=0.75
PROFIT_LOCK_MID_TRIGGER_USD=0.60
PROFIT_LOCK_MID_FRACTION=0.35
PROFIT_LOCK_FINAL_TRIGGER_USD=1.15
PROFIT_LOCK_FINAL_FLOOR_USD=1.00
BREAKEVEN_TRIGGER_R=0.75
TRAILING_TRIGGER_R=1.00
